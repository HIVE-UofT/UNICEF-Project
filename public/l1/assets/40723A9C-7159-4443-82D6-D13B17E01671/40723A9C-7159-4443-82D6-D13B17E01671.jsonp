3916015625,"width":149.57999999999993,"height":25.949999999999989}},{"text":"equation.pdf","targetRectangle":{"y":452.70703167781653,"x":569.26857215657992,"width":58.740644859813074,"height":33.056074766355152}},{"text":"Experience– Suppose we have a dataset of individuals with the following columns: ","targetRectangle":{"y":367.44589233398438,"x":101.91743469238281,"width":1108.1099999999994,"height":36}},{"text":"￼: Fasting blood sugar level","targetRectangle":{"y":404.31610107421875,"x":301.91743290424347,"width":344.84937165340568,"height":41.054134048034086}},{"text":"￼: Body Mass Index (￼) ","targetRectangle":{"y":445.37023512225284,"x":301.91743290424347,"width":342.58878411214948,"height":41.054134048034086}},{"text":"￼ [Label]: Diabetes Status (0 for No, 1 for Yes)","targetRectangle":{"y":486.42436917028692,"x":301.91743290424347,"width":553.86689719626179,"height":40.392871321918847}},{"text":"equation.pdf","targetRectangle":{"y":330.63644409179688,"x":1487.1763916015625,"width":164.57999999999993,"height":25.589999999999975}},{"text":"© Zahra Shakeri, Dalla Lana School of Public Health, University of Toronto","targetRectangle":{"y":1055.1609382629395,"x":54.743599891662598,"width":495.66000000000008,"height":16.580001831054688}},{"text":"label-tag-with-white-details-and-string.png","targetRectangle":{"y":56.325447082519531,"x":778.1090087890625,"width":115.56040191650391,"height":115.56040191650391}},{"text":"￼","targetRectangle":{"y":1051.2967231273651,"x":17.150898866995703,"width":20.015999999999998,"height":21.496002197265625}},{"text":"equation.pdf","targetRectangle":{"y":527.8900146484375,"x":1359.0550537109375,"width":158.26222222222214,"height":24.220000000000027}},{"text":"neural-network.png","targetRectangle":{"y":448.97747802734375,"x":1488.2344970703125,"width":159.82780456542969,"height":152.46101379394531}},{"text":"equation.pdf","targetRectangle":{"y":415.984375,"x":1490.9263916015625,"width":142.07999999999993,"height":25.949999999999989}