le":{"y":874.12556838989258,"x":840.45402275491506,"width":285.85095739737153,"height":105.26865455356892}},{"text":"© Zahra Shakeri, Dalla Lana School of Public Health, University of Toronto","targetRectangle":{"y":1055.1609382629395,"x":54.743599891662598,"width":495.66000000000008,"height":16.580001831054688}},{"text":"Unsupervised Learning","targetRectangle":{"y":576.44829559326172,"x":1024.1139492206275,"width":262.15084018371999,"height":105.26865455356892}},{"text":"label-tag-with-white-details-and-string.png","targetRectangle":{"y":422.65032958984375,"x":729.76860046386719,"width":122.99440765380859,"height":122.99440765380859}},{"text":"Taxonomy of machine learning tasks","targetRectangle":{"y":65.156173706054688,"x":355.77163696289062,"width":1171.1399999999996,"height":60.19999635219574}},{"text":"Supervised Learning","targetRectangle":{"y":564.32224655151367,"x":705.14344646967947,"width":217.49279325641692,"height":105.26865455356892}},{"text":"learning.png","targetRectangle":{"y":715.36985015869141,"x":914.59255981445312,"width":146.63043212890625,"height":146.63043212890625}},{"text":"pasted-image.tiff","targetRectangle":{"y":1025.85791015625,"x":1546.1016387939453,"width":222.40380859375,"height":40.216812133789062}},{"text":"traffic-signal.png","targetRectangle":{"y":426.08078002929688,"x":1057.9975509643555,"width":152.46192932128906,"height":152.46192932128906}},{"text":"logo.png","targetRectangle":{"y":1018.2626953125,"x":1367.8631134033203,"width":167.89532470703125,"height":53.40728759765625}},{"text":"Example-A public health system employs unsupervised learning to group regions with similar vaccination rates. In regions with lower rates, it utilizes diverse outreach tactics and applies reinforcement learning to identify the most effective strategies, adjusting its methods accordingly.","targetRectangle":{"y":804.56861877441406,"x":1364.0115203857422,"width":476.65000000000009,"height":181.24999848008156}}],"baseLayer":{"animations":[],"initial