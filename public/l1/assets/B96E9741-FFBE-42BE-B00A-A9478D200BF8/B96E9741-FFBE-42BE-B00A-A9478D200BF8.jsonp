ved from the board.","targetRectangle":{"y":419.83978354930878,"x":194.65586853027344,"width":778.9267578125,"height":50}},{"text":"Jump over your opponent's checker, landing in an empty space just behind it.","targetRectangle":{"y":381.54944181442261,"x":193.929931640625,"width":944.90700000000083,"height":29.129998236894608}},{"text":"Players roll a dice to decide the first move.","targetRectangle":{"y":144.64815092086792,"x":198.61901187896729,"width":526.23400000000038,"height":29.129998236894608}},{"text":"pasted-image.pdf","targetRectangle":{"y":608.373779296875,"x":1615.6630859375,"width":36.558914184570312,"height":36.558231353759766}},{"text":"pasted-image.pdf","targetRectangle":{"y":666.43560791015625,"x":1675.0015869140625,"width":36.558914184570312,"height":36.558231353759766}},{"text":"pasted-image.pdf","targetRectangle":{"y":726.8238525390625,"x":1615.6630859375,"width":36.558914184570312,"height":36.558231353759766}},{"text":"Check for more jumping opportunities to continue your turn, allowing consecutive jumps.","targetRectangle":{"y":496.78412139415741,"x":193.929931640625,"width":853.09300000000007,"height":59.129998236894608}},{"text":"pasted-image.pdf","targetRectangle":{"y":322.66851806640625,"x":1559.5286865234375,"width":36.558914184570312,"height":36.558231353759766}},{"text":"pasted-image.pdf","targetRectangle":{"y":125.64815521240234,"x":760.03448486328125,"width":63.226840972900391,"height":67.129997253417969}},{"text":"pasted-image.pdf","targetRectangle":{"y":666.43560791015625,"x":1444.0557861328125,"width":36.558914184570312,"height":36.558231353759766}},{"text":"pasted-image.pdf","targetRectangle":{"y":493.94393920898438,"x":1384.71728515625,"width":36.558914184570312,"height":36.558231353759766}},{"text":"pasted-image.pdf","targetRectangle":{"y":726.8238525390625,"x":1269.244384765625,"width":36.558914184570312,"height":36.558231353759766}},{"text":"pasted-image.pdf","targetRectangle":{"y":377.8353271484375,"x":1731.135986328125,"widt