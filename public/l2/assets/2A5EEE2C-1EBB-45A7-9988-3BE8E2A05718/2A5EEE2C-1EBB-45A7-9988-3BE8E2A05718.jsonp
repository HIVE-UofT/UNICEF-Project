text":"(     )","targetRectangle":{"y":796.65679931640625,"x":1144.26123046875,"width":95.400000000000091,"height":58.600006103515625}},{"text":"pasted-image.pdf","targetRectangle":{"y":764.039794921875,"x":1198.8580322265625,"width":12.061081886291504,"height":103.40578460693359}},{"text":"equation.pdf","targetRectangle":{"y":386.98139953613281,"x":527.37448629760752,"width":15.733990654205627,"height":41.815301199939768}},{"text":"equation.pdf","targetRectangle":{"y":386.98139953613281,"x":1017.1339395686358,"width":15.733990654205513,"height":42.081292195970775}},{"text":"equation.pdf","targetRectangle":{"y":316.29507981059703,"x":430.58741271182834,"width":22.78715887850467,"height":60.560091393016194}},{"text":"If a person does not smoke, the risk is 1%.","targetRectangle":{"y":663.6871337890625,"x":127.24706244468689,"width":592.1189999999998,"height":47.027696621558789}},{"text":"For every cigarette smoked daily, the risk increases by 0.5%.","targetRectangle":{"y":710.71483041062129,"x":127.24706244468689,"width":834.00900000000001,"height":47.027696621558789}},{"text":"function.png","targetRectangle":{"y":99.724189758300781,"x":486.18515014648438,"width":88.853302001953125,"height":88.853302001953125}},{"text":"This notation means that for a given '￼' value, the function '￼' will produce a '￼' value.","targetRectangle":{"y":386.98139953613281,"x":65.955486297607422,"width":1055.5654439252337,"height":42.116729111858604}},{"text":"equation.pdf","targetRectangle":{"y":816.52142333984375,"x":817.347900390625,"width":311.69599999999991,"height":41.124000000000024}},{"text":"pasted-image.tiff","targetRectangle":{"y":1019.2137107849121,"x":1781.0107097625732,"width":118.83621215820312,"height":34.581336975097656}},{"text":"pasted-image.pdf","targetRectangle":{"y":763.63885498046875,"x":1170.0482177734375,"width":12.061081886291504,"height":103.40578460693359}},{"text":"pasted-image.pdf","targetRectangle":{"y":763.63885498046875,"x":1198.8580322265625,"width":12.06