9,"width":20.015999999999998,"height":21.496002197265625}},{"text":"Similar to KNN, K-means also relies on the concept of proximity in data space. While KNN focuses on classification based on the labels of its nearest neighbours, K-Means focuses on clustering data into groups based on their proximity to each other, without using labels.","targetRectangle":{"y":253.10057067871094,"x":104.56751253642142,"width":1546.1999999999998,"height":241.47787987658376}},{"text":"pasted-image.tiff","targetRectangle":{"y":1016.3959617614746,"x":1548.2637615203857,"width":222.40380859375,"height":40.216812133789062}},{"text":"equation.pdf","targetRectangle":{"y":690.59530115127563,"x":1350.4030688362122,"width":30.156815420560633,"height":53.350556703371467}},{"text":"K-Means Clustering","targetRectangle":{"y":70.103340148925781,"x":105.45293426513672,"width":834.96000000000004,"height":79.599995136260986}},{"text":"© Zahra Shakeri, Dalla Lana School of Public Health, University of Toronto","targetRectangle":{"y":1048.1306190490723,"x":51.769003868103027,"width":495.66000000000008,"height":16.580001831054688}},{"text":"Group #1","targetRectangle":{"y":567.30871587991714,"x":418.65456032752991,"width":100.48799999999994,"height":28.3280029296875}},{"text":"pasted-image.tiff","targetRectangle":{"y":1019.2137107849121,"x":1781.0107097625732,"width":118.83621215820312,"height":34.581336975097656}},{"text":"Group #2","targetRectangle":{"y":567.30871587991714,"x":883.43196511268616,"width":100.48799999999994,"height":28.3280029296875}},{"text":"logo.png","targetRectangle":{"y":1008.8007469177246,"x":1370.0252361297607,"width":167.89532470703125,"height":53.40728759765625}},{"text":"From Neighbourhoods to Grouping!","targetRectangle":{"y":165.16770935058594,"x":105.45293426513672,"width":552.60000000000014,"height":30.09999817609787}}],"baseLayer":{"animations":[],"initialState":{"affineTransform":[1,0,0,1,0,0],"masksToBounds":false,"rotation":0,"scale":1,"position":{"pointX":960,"pointY"