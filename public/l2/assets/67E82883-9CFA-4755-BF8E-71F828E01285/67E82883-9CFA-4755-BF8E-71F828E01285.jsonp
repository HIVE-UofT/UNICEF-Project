":1781.0107097625732,"width":118.83621215820312,"height":34.581336975097656}},{"text":"equation.pdf","targetRectangle":{"y":357.70738476251063,"x":477.23125758886329,"width":143.54129842906457,"height":67.718042837125154}},{"text":"In supervised learning, we have a dataset consisting of input-output pairs, usually denoted as ￼, ￼, ￼, where ￼ is the input and  ￼ is the corresponding output. The goal is to learn a function ￼ such that for a new input ￼, the function can predict the output ￼ with accuracy (￼).","targetRectangle":{"y":291.96844482421875,"x":103.01125758886337,"width":1526.9647402315397,"height":306.07220235986279}},{"text":"logo.png","targetRectangle":{"y":1008.8007469177246,"x":1370.0252361297607,"width":167.89532470703125,"height":53.40728759765625}},{"text":"equation.pdf","targetRectangle":{"y":516.56211016990562,"x":1391.5692071861524,"width":170.448864307539,"height":65.353545173573707}},{"text":"equation.pdf","targetRectangle":{"y":438.76427133937079,"x":1200.8312575888633,"width":15.286752336448671,"height":65.353545173573707}},{"text":"equation.pdf","targetRectangle":{"y":859.47650146484375,"x":1156.1426391601562,"width":23.869999999999891,"height":30.940000000000055}},{"text":"equation.pdf","targetRectangle":{"y":357.70738476251063,"x":814.57495640068441,"width":221.44141525149439,"height":68.069418187592419}},{"text":"equation.pdf","targetRectangle":{"y":357.70738476251063,"x":645.79255601792784,"width":143.7624003827566,"height":67.718042837125154}},{"text":"equation.pdf","targetRectangle":{"y":723.53818511962891,"x":894.1739501953125,"width":39.815997626781495,"height":37.967997736930897}},{"text":"The idea of supervised learning is to learn a function ￼ based on the training data and then test its performance on previously unseen data.","targetRectangle":{"y":944.03221130371094,"x":102.06828308105469,"width":1715.8634626168225,"height":42.116729111858604}},{"text":"equation.pdf","targetRectangle":{"y":357.70738476251063,"x":1550.57118473629