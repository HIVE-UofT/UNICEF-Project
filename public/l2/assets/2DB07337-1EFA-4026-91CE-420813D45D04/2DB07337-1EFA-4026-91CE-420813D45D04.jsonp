"transition","attributes":{"direction":0},"name":"none","objectID":"0"}],"automaticPlay":false,"hyperlinks":[],"accessibility":[{"text":"C2","targetRectangle":{"y":549.4252855181694,"x":1355.74975502491,"width":45.394999999999982,"height":41.984756469726562}},{"text":"Example-Monitoring Mental Health in Different Neighborhoods","targetRectangle":{"y":165.16770935058594,"x":105.45293426513672,"width":1135.6340000000005,"height":33.979997932910919}},{"text":"© Zahra Shakeri, Dalla Lana School of Public Health, University of Toronto","targetRectangle":{"y":1048.1306190490723,"x":51.769003868103027,"width":495.66000000000008,"height":16.580001831054688}},{"text":"pasted-image.tiff","targetRectangle":{"y":1019.2137107849121,"x":1781.0107097625732,"width":118.83621215820312,"height":34.581336975097656}},{"text":"K-Means Clustering","targetRectangle":{"y":70.103340148925781,"x":105.45293426513672,"width":834.96000000000004,"height":79.599995136260986}},{"text":"C1","targetRectangle":{"y":680.52368181943893,"x":1119.8022547960281,"width":45.394999999999982,"height":41.984756469726562}},{"text":"pasted-image.tiff","targetRectangle":{"y":1016.3959617614746,"x":1548.2637615203857,"width":222.40380859375,"height":40.216812133789062}},{"text":"equation.pdf","targetRectangle":{"y":597.86361164434857,"x":297.97816252231598,"width":24.451471962616836,"height":43.257208137868702}},{"text":"The city officials want to identify neighbourhoods or zones that are most stressed, so they can establish mental health support centers.","targetRectangle":{"y":237.98306274414062,"x":111.18898922204971,"width":1510.47,"height":99}},{"text":"logo.png","targetRectangle":{"y":1008.8007469177246,"x":1370.0252361297607,"width":167.89532470703125,"height":53.40728759765625}},{"text":"Each data point is a geolocation of a survey response, possibly weighted by the stress level reported. Using K-Means, the city is divided into ￼ clusters. The centroids of clusters with the highest average stress scores co