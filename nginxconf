server {
  if ($host = ml.hivelab-uoft.ca) {
      return 301 https://$host$request_uri;
  }
  listen 80;
  server_name ml.hivelab-uoft.ca;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name ml.hivelab-uoft.ca;
  root   /var/www/html/ml-course/;
  index  index.html;
  try_files $uri $uri /index.html =404;
  ssl_certificate /etc/letsencrypt/live/ml.hivelab-uoft.ca/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/ml.hivelab-uoft.ca/privkey.pem;
}